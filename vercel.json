{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    { "source": "/miljoer/(.*)\\.jpg", "headers": [{ "key": "Cache-Control", "value": "private, max-age=86400" }] },
    { "source": "/miljoer/manifest.json", "headers": [{ "key": "Cache-Control", "value": "private, no-cache" }] }
  ]
}
